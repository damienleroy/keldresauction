@inherits LayoutComponentBase

@* Required once at the root: overlay containers for dialogs, tooltips and keyboard shortcuts. *@
<FluentProviders />

<FluentLayout>
    <FluentLayoutItem Area="LayoutArea.Header">
        <div class="app-brand">
            <FluentIcon Value="@(new Icons.Filled.Size24.Gavel())" />
            <span class="app-title">Keldres Auction</span>
        </div>
    </FluentLayoutItem>

    <FluentLayoutItem Area="LayoutArea.Content">
        <main class="app-content">
            @Body
        </main>
    </FluentLayoutItem>
</FluentLayout>
