@page "/"
@inject HttpClient Http

<PageTitle>Keldres Auction</PageTitle>

<h1>Keldres Auction</h1>

<FluentCard Padding="Padding.All4">
    @if (error is not null)
    {
        <p role="alert">API error: @error</p>
    }
    else if (message is null)
    {
        <FluentProgressBar />
    }
    else
    {
        <p id="api-message">@message</p>
    }
</FluentCard>

@code {
    private string? message;
    private string? error;

    private sealed record HelloResponse(string Message);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<HelloResponse>("api/hello");
            message = response?.Message ?? string.Empty;
        }
        catch (HttpRequestException ex)
        {
            error = ex.Message;
        }
    }
}
